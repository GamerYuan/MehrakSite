{
  "name": "mehrak-dashboard",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "test": "vitest",
    "test:ci": "vitest run",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "oxfmt --write \"src/**/*.{js,vue,css}\""
  },
  "dependencies": {
    "@primeuix/themes": "^2.0.2",
    "@tailwindcss/vite": "^4.1.18",
    "nsfwjs": "^4.3.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "tailwindcss": "^4.1.18",
    "vue": "^3.5.24",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.39.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "jsdom": "^26.1.0",
    "oxfmt": "^0.56.0",
    "oxlint": "^1.6.0",
    "vite": "^7.2.4",
    "vitest": "^3.2.4",
    "wrangler": "^4.95.0"
  }
}
